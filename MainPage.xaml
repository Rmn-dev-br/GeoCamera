<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GeoCamera"
             x:Class="GeoCamera.MainPage" Title="GeoCamera" BackgroundColor="#121212">
    <Grid Padding="16" RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label Text="GeoCamera" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
            <Button Grid.Column="1" x:Name="SettingsButton" Text="⚙" FontSize="22" WidthRequest="44" HeightRequest="44"
                    CornerRadius="22" BackgroundColor="#2A2A2A" TextColor="White" Clicked="OnSettingsClicked" />
        </Grid>

        <Grid x:Name="PreviewBox" Grid.Row="1" BackgroundColor="Black" SizeChanged="OnPreviewSizeChanged">
            <local:CameraPreview x:Name="Preview" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label x:Name="GpsLabel" Text="Aguardando localização..." TextColor="White"
                   BackgroundColor="Black" Padding="10" VerticalOptions="End" FontSize="14" />
        </Grid>

        <Label x:Name="StatusLabel" Grid.Row="2" Text="Preparando câmera..." TextColor="White" />

        <Button x:Name="RecordButton" Grid.Row="3" Text="●" Clicked="OnRecordClicked" IsEnabled="False"
                WidthRequest="86" HeightRequest="86" CornerRadius="43" FontSize="36"
                HorizontalOptions="Center" VerticalOptions="Center"
                BackgroundColor="#D32F2F" TextColor="White" BorderColor="White" BorderWidth="3" />

        <Button x:Name="FilesButton" Grid.Row="4" Text="Gravações" Clicked="OnFilesClicked" />
    </Grid>
</ContentPage>
