<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GeoCamera"
             x:Class="GeoCamera.MainPage" Title="GeoCamera" BackgroundColor="Black">
    <!-- Full-screen preview with controls hovering on top (standard camera UI). -->
    <Grid x:Name="PreviewBox" BackgroundColor="Black" SizeChanged="OnPreviewSizeChanged">
        <local:CameraPreview x:Name="Preview" HorizontalOptions="Center" VerticalOptions="Center" />

        <!-- Top bar -->
        <Grid ColumnDefinitions="*,Auto" Padding="16,12" VerticalOptions="Start">
            <Label Text="GeoCamera" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
            <Button Grid.Column="1" x:Name="SettingsButton" Text="⚙" FontSize="22" WidthRequest="44" HeightRequest="44"
                    CornerRadius="22" BackgroundColor="#802A2A2A" TextColor="White" Clicked="OnSettingsClicked" />
        </Grid>

        <!-- GPS / status overlay above the bottom controls -->
        <VerticalStackLayout VerticalOptions="End" Spacing="4" Padding="16,0,16,12">
            <Label x:Name="GpsLabel" Text="Aguardando localização..." TextColor="White"
                   BackgroundColor="#99000000" Padding="10" FontSize="14" HorizontalOptions="Start" />
            <Label x:Name="StatusLabel" Text="Preparando câmera..." TextColor="White"
                   BackgroundColor="#99000000" Padding="10,6" FontSize="13" HorizontalOptions="Start" />
        </VerticalStackLayout>

        <!-- Bottom controls -->
        <Grid VerticalOptions="End" Padding="16" ColumnDefinitions="*,Auto,*">
            <Button Grid.Column="0" x:Name="FilesButton" Text="Gravações" Clicked="OnFilesClicked"
                    BackgroundColor="#802A2A2A" TextColor="White" HorizontalOptions="Start" VerticalOptions="End" />

            <Button Grid.Column="1" x:Name="RecordButton" Text="●" Clicked="OnRecordClicked" IsEnabled="False"
                    WidthRequest="86" HeightRequest="86" CornerRadius="43" FontSize="36"
                    HorizontalOptions="Center" VerticalOptions="End"
                    BackgroundColor="#D32F2F" TextColor="White" BorderColor="White" BorderWidth="3" />
        </Grid>
    </Grid>
</ContentPage>
